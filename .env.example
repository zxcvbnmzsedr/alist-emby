# This is a template; Python does not automatically load dotenv files.
# For systemd, use deploy/alist-emby.env.example with EnvironmentFile.
BIND_HOST=127.0.0.1
PORT=8097
PUBLIC_ORIGIN=https://media.example.com
ALIST_ORIGIN=http://127.0.0.1:5244
CATALOG_PATH=/srv/alist-emby/catalog/catalog.json
STATE_PATH=/var/lib/alist-emby
