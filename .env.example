# Shell-compatible template; Python does not automatically load dotenv files.
# Server wrappers and systemd can read /etc/alist-emby.env.
BIND_HOST=127.0.0.1
PORT=8097
PUBLIC_ORIGIN=https://media.example.com
ALIST_ORIGIN=http://127.0.0.1:5244
CATALOG_PATH=/srv/alist-emby/www/cinema/catalog.json
STATE_PATH=/var/lib/alist-emby
# Optional local-account mode: configure BOTH, and grant read access.
# ALIST_DATABASE=/srv/alist/data/data.db
# ALIST_CONFIG=/srv/alist/data/config.json
# Server CLI tools need ALIST_TOKEN or readonly ALIST_DATABASE.
# ALIST_TOKEN=YOUR_PRIVATE_API_TOKEN
MEDIA_ROOT=/m3u8
CATALOG_OUTPUT=/srv/alist-emby/www/cinema
SCRAPER_STATE_PATH=/var/lib/alist-emby/scraper
BATCH_STATE_PATH=/var/lib/alist-emby/batches
BATCH_PACKS_PATH=/srv/alist-emby/packs
ALIST_LOCAL_PACK_ROOT=/local/packs
ALIST_SEGMENT_ROOT=/cloud/raw
ALIST_EMBY_REMOTE_ROOT=/opt/alist-emby
# Local workstation options; remote path settings must match server config:
# ALIST_EMBY_SSH_HOST=YOUR_SSH_HOST
# ALIST_EMBY_WORK_DIR=/path/to/private/work
# ALIST_EMBY_VIDEO_ENCODER=libx264
# ALIST_EMBY_PYTHON=/opt/alist-emby/.venv/bin/python
